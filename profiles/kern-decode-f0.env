# kern-decode shipping stack F0 (LADDER.md, leases kern-r8 and kern-r21).
# Add these lines after the node .env (spark2: MTP K=6, MAX_NUM_SEQS=4).
# Measured on spark2 in one launch (kern-r21): 64.89 ms per decode step against
# 73.17 ms with every knob off, 79.9 against 71.5 tok/s on the long code prompts.
#
#   R5  FP8 lm_head screen + BF16 rescore      LM_HEAD_FP8_RESCORE=1
#   R1  1-token draft decode graphs            CUDAGRAPH_CAPTURE_SIZES has 1..MAX_NUM_SEQS
#   R2  short-conv async H2D                   SHORTCONV_ASYNC_H2D=1
#   R4  MTP dense weights W8A16                MTP_DENSE_W8A16=1
#   R3a GPU-side PLE row pull (v2)             PLE_GPU_WAIT=1
#   R8  4-bit reduced draft head               MTP_DRAFT_HEAD_W4=1
#   R14 fused MTP input GemmaRMSNorm           MTP_FUSED_NORM=1
# Not shipped: R17 (tau loss), R6 KERN_SKINNY (speed resolved in kern-r21 but
# the decode-logprob gate is open), R21 QSA_FUSED_DRAFT (no draft gain).
KERN_DECODE=1
KERN_RPC=${KERN_RPC:-0}
LM_HEAD_FP8_RESCORE=1
SHORTCONV_ASYNC_H2D=1
MTP_DENSE_W8A16=1
PLE_GPU_WAIT=1
MTP_DRAFT_HEAD_W4=1
MTP_FUSED_NORM=1
CUDAGRAPH_CAPTURE_SIZES=${CUDAGRAPH_CAPTURE_SIZES:-1,2,3,4,7,14,21,28}
